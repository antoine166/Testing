# Copy this file to .env.local and fill in the values from your Supabase project.
# Project Settings -> API in the Supabase dashboard.
# Never commit .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — server-side only, never expose to the client.
# Used by the email-capture webhook to create tasks without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — powers the Coach feature. Get one at console.anthropic.com.
# Server-side only, never expose to the client (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Email capture (forward an email in, it becomes a task) — get these from
# resend.com. RESEND_API_KEY is a normal API key. RESEND_WEBHOOK_SECRET comes
# from the webhook's details page after you create it (Resend dashboard ->
# Webhooks -> add endpoint -> event: email.received). INBOUND_ALLOWED_SENDER
# is the only address allowed to create tasks this way — set it to your own
# email (the one you log into this app with).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_ALLOWED_SENDER=
