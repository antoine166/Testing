# Copy this file to .env.local and fill in the values from your Supabase project.
# Project Settings -> API in the Supabase dashboard.
# Never commit .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — server-side only, never expose to the client.
# Used by the email-capture webhook to create tasks without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — powers the Coach feature. Get one at console.anthropic.com.
# Server-side only, never expose to the client (no NEXT_PUBLIC_ prefix).
ANTHROPIC_API_KEY=

# Gmail connection (Settings page) — lets forwarded emails (below) get an
# authoritative "open in Gmail" link instead of a best-guess parsed one.
# Optional: everything else works fine without it.
# Set up in Google Cloud Console (console.cloud.google.com):
#   1. Create a project (or use an existing one) -> APIs & Services -> Library
#      -> enable the "Gmail API"
#   2. APIs & Services -> OAuth consent screen -> User Type "External" is
#      fine for personal use -> add your own Google account as a test user
#      (keeps the app in "Testing" status, no Google review needed)
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#      -> Application type "Web application"
#   4. Authorized redirect URIs -> add https://<your-vercel-domain>/api/gmail/callback
#      (and http://localhost:3000/api/gmail/callback for local dev, if you test there)
#   5. Copy the generated Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email capture (forward an email in, it becomes a task) — get these from
# resend.com. RESEND_API_KEY is a normal API key. RESEND_WEBHOOK_SECRET comes
# from the webhook's details page after you create it (Resend dashboard ->
# Webhooks -> add endpoint -> event: email.received). INBOUND_ALLOWED_SENDER
# is the address (or comma-separated addresses) allowed to create tasks this
# way — it does NOT need to match the email you log into this app with.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_ALLOWED_SENDER=

# Claude/MCP integration — lets claude.ai or Claude Desktop connect to this
# app as a custom connector (Settings -> Connectors -> Add custom connector,
# URL: https://<your-vercel-domain>/api/mcp). No new env var needed: it's a
# full OAuth 2.1 + PKCE server (app/api/mcp/{register,authorize,token}),
# gated by logging in with your existing account above — claude.ai's "Add
# custom connector" flow handles the rest automatically.

# Plain token-secured digest endpoint (GET /api/digest, Authorization:
# Bearer <value>) — used by the scheduled daily-digest routine, which calls
# it directly via curl instead of through the MCP connector, so it works
# regardless of which session the routine happens to be running in.
# Generate with `openssl rand -hex 32`.
DIGEST_ACCESS_TOKEN=

# Plain token-secured clip endpoint (POST /api/clip, Authorization:
# Bearer <value>) — used by the Life OS Clipper Chrome extension
# (chrome-extension/), which has no way to share the app's session cookie.
# Generate with `openssl rand -hex 32`, then paste the same value into the
# extension's options page (see chrome-extension/README.md).
EXTENSION_ACCESS_TOKEN=
