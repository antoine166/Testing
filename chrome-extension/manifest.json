{
  "manifest_version": 3,
  "name": "Life OS Clipper",
  "version": "1.0.0",
  "description": "Save the current page (or a selection) to your Life OS Knowledge Library.",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://testing-azure-eta.vercel.app/*", "http://localhost:3000/*"]
}
